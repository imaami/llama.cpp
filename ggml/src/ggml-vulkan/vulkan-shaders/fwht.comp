#version 450

#extension GL_EXT_control_flow_attributes : require
#ifdef FWHT_F16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
#ifndef FWHT_SHMEM
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#endif

layout(constant_id = 0) const uint BLOCK_SIZE = 32;
layout(constant_id = 1) const uint N = 128;
layout(constant_id = 2) const uint ROWS = 4;

layout(local_size_x_id = 0, local_size_y_id = 2, local_size_z = 1) in;

layout(push_constant) uniform parameter
{
    uint n_rows;
    uint src_offset;
    uint dst_offset;
    float scale;
#ifdef FWHT_SIGNED
    uint sign_width;
    uint sign_offset;
    uint up_offset;
#endif
};

layout(binding = 0, std430) readonly buffer A {
#ifdef FWHT_F16
    float16_t data_a[];
#else
    float data_a[];
#endif
};
layout(binding = 1, std430) writeonly buffer D { float data_d[]; };
#ifdef FWHT_SIGNED
layout(binding = 2, std430) readonly buffer S { float data_s[]; };
#endif
#ifdef FWHT_SWIGLU
layout(binding = 3, std430) readonly buffer U { float data_u[]; };
#endif
#ifdef FWHT_Q8
#ifdef FWHT_SWIGLU
layout(binding = 4, std430) writeonly buffer Q { uint data_q[]; };
#elif defined(FWHT_SIGNED)
layout(binding = 3, std430) writeonly buffer Q { uint data_q[]; };
#else
layout(binding = 2, std430) writeonly buffer Q { uint data_q[]; };
#endif
#endif

const uint EL_W = N / BLOCK_SIZE;

#ifdef FWHT_SHMEM
shared float shmem[ROWS * N];
#endif

#ifdef FWHT_Q8
// Each Q8_1 block covers 32 values; four blocks share one 144-byte packed record.
const uint Q8_LANES = BLOCK_SIZE < 32u ? BLOCK_SIZE : 32u;
const uint Q8_REGS = 32u / Q8_LANES;

void quantize_row(float values[EL_W], const uint row, const uint tid) {
    [[unroll]] for (uint base = 0; base < EL_W; base += Q8_REGS) {
        float amax = 0.0;
        [[unroll]] for (uint j = 0; j < Q8_REGS; ++j) {
            amax = max(amax, abs(values[base + j]));
        }
        [[unroll]] for (uint h = 1; h < Q8_LANES; h <<= 1) {
            amax = max(amax, subgroupShuffleXor(amax, h));
        }
        precise float d = amax / 127.0;
        precise float inv_d = d != 0.0 ? 1.0 / d : 0.0;
        float sum = 0.0;
        [[unroll]] for (uint j = 0; j < Q8_REGS; ++j) {
            precise float q = round(values[base + j] * inv_d);
            sum += q;
            const uint byte = uint(int(q)) & 255u;
            // All lanes execute the shuffles, including lanes which do not store.
            const uint packed = byte | (subgroupShuffleXor(byte, 1u) << 8u) |
                (subgroupShuffleXor(byte, 2u) << 16u) | (subgroupShuffleXor(byte, 3u) << 24u);
            if (tid % 4u == 0) {
                const uint e = row * N + (base + j) * BLOCK_SIZE + tid;
                data_q[(e / 128u) * 36u + 4u + (e % 128u) / 4u] = packed;
            }
        }
        [[unroll]] for (uint h = 1; h < Q8_LANES; h <<= 1) {
            sum += subgroupShuffleXor(sum, h);
        }
        if (tid % 32u == 0) {
            const uint e = row * N + base * BLOCK_SIZE + tid;
            // Use the unrounded scale for s, as quantize_q8_1.comp does.
            data_q[(e / 128u) * 36u + (e % 128u) / 32u] = packHalf2x16(vec2(d, sum * d));
        }
    }
}
#endif

void main() {
#ifdef FWHT_SHMEM
    const uint tid = gl_LocalInvocationID.x;
    const uint shmem_base = gl_LocalInvocationID.y * N;
    const uint row_id = gl_LocalInvocationID.y;
#else
    const uint tid = gl_SubgroupInvocationID;
    const uint row_id = gl_SubgroupID;
#endif

    for (uint base_row = gl_WorkGroupID.x * gl_WorkGroupSize.y;
            base_row < n_rows;
            base_row += gl_NumWorkGroups.x * gl_WorkGroupSize.y) {
        const uint row = base_row + row_id;
        const uint row_offset = row * N;
#ifdef FWHT_SIGNED
        const uint sign_row_offset = sign_offset + row_offset % sign_width;
#endif

#ifndef FWHT_SHMEM
        if (row >= n_rows) {
            continue;
        }
#endif

        float reg[EL_W];

        [[unroll]]
        for (uint i = 0; i < EL_W; ++i) {
#ifdef FWHT_SIGNED
            const uint col = row_offset + i * BLOCK_SIZE + tid;
            precise float input_val = row < n_rows ? data_a[src_offset + col] : 0.0;
#ifdef FWHT_SWIGLU
            // Preserve the F32 SwiGLU result before sign multiplication and normalization.
            precise float glu = row < n_rows ? input_val / (1.0 + exp(-input_val)) * data_u[up_offset + col] : 0.0;
            input_val = glu;
#endif
            precise float val = row < n_rows ? input_val * data_s[sign_row_offset + i * BLOCK_SIZE + tid] : 0.0;
            precise float scaled = val * scale;
            reg[i] = scaled;
#else
            reg[i] = row < n_rows ? float(data_a[src_offset + row_offset + i * BLOCK_SIZE + tid]) * scale : 0.0;
#endif
        }

#ifdef FWHT_SHMEM
        [[unroll]]
        for (uint h = 1; h < BLOCK_SIZE; h <<= 1) {
            [[unroll]]
            for (uint i = 0; i < EL_W; ++i) {
                shmem[shmem_base + i * BLOCK_SIZE + tid] = reg[i];
            }
            barrier();
            [[unroll]]
            for (uint j = 0; j < EL_W; ++j) {
                const float val = reg[j];
                const float other = shmem[shmem_base + j * BLOCK_SIZE + (tid ^ h)];
                reg[j] = (tid & h) == 0 ? val + other : other - val;
            }
            barrier();
        }
#else
        [[unroll]]
        for (uint h = 1; h < BLOCK_SIZE; h <<= 1) {
            [[unroll]]
            for (uint j = 0; j < EL_W; ++j) {
                const float val = reg[j];
                const float val2 = subgroupShuffleXor(val, h);
                reg[j] = (tid & h) == 0 ? val + val2 : val2 - val;
            }
        }
#endif

        [[unroll]]
        for (uint h = BLOCK_SIZE; h < N; h <<= 1) {
            const uint step = h / BLOCK_SIZE;
            [[unroll]]
            for (uint j = 0; j < EL_W; j += 2 * step) {
                [[unroll]]
                for (uint k = 0; k < step; ++k) {
                    const float x = reg[j + k];
                    const float y = reg[j + k + step];
                    reg[j + k] = x + y;
                    reg[j + k + step] = x - y;
                }
            }
        }

#ifdef FWHT_Q8
        quantize_row(reg, row, tid);
#endif

#ifdef FWHT_SHMEM
        if (row < n_rows) {
#endif
            [[unroll]]
            for (uint i = 0; i < EL_W; ++i) {
                data_d[dst_offset + row_offset + i * BLOCK_SIZE + tid] = reg[i];
            }
#ifdef FWHT_SHMEM
        }
        barrier();
#endif
    }
}
