#version 450

layout(local_size_x = 128) in;
layout(binding = 0) readonly  buffer F { float forget[]; };
layout(binding = 1) readonly  buffer C { float cur[]; };
layout(binding = 2) readonly  buffer G { float gain[]; };
layout(binding = 3) readonly  buffer M { float message[]; };
layout(binding = 4) writeonly buffer D { float dst[]; };

layout(push_constant) uniform Params {
    uint n;
    uint forget_offset, cur_offset, gain_offset, message_offset, dst_offset;
} p;

// Use the same tanh as unary.comp and preserve rounding at each GGML operation.
float gate(float x) {
    return 1.0 - 2.0 / (exp(2.0*x) + 1.0);
}

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += gl_NumWorkGroups.x * gl_WorkGroupSize.x) {
        float x = cur[p.cur_offset + i];
        precise float retained = x - gate(forget[p.forget_offset + i]) * x;
        precise float mixed = retained + gate(gain[p.gain_offset + i]) * message[p.message_offset + i];
        dst[p.dst_offset + i] = mixed;
    }
}
